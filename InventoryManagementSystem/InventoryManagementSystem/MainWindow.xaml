<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="InventoryManagementSystem.MainWindow"
        Title="Inventory System" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- COLUMNS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 🔴 TOP HEADER -->
        <Border Background="#E4002B"
        Grid.ColumnSpan="2"
        Height="60">

            <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="20,0">
                <Image Source="Assets/Airtel_logo.png"
               Height="57"
               Width="65"
               Stretch="Uniform"/>



            </StackPanel>

        </Border>

        <!-- 🟤 SIDEBAR -->
        <StackPanel Grid.Row="1" Background="#F2F2F2">

            <!-- TITLE -->
            <TextBlock Text="INVENTORY"
               Foreground="black"
               FontSize="16"
               FontWeight="Bold"
               Margin="15"/>
            <!-- DASHBOARD -->

            <Button Background="Transparent"
            BorderThickness="0"
            Foreground="black"
            Height="40"
            HorizontalContentAlignment="Left"
            Padding="15,0">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock Text="Dashboard" FontSize="14"/>
                </StackPanel>

            </Button>

            <!-- ASSETS -->
            <Button Background="Transparent"
        BorderThickness="0"
        Foreground="black"
        Height="40"
        HorizontalContentAlignment="Left"
        Padding="15,0"
        Click="Assets_Click">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💻" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock Text="Assets" FontSize="14"/>
                </StackPanel>

            </Button>

            <!-- ASSIGNMENTS -->
            <Button Background="Transparent"
            BorderThickness="0"
            Foreground="black"
            Height="40"
            HorizontalContentAlignment="Left"
            Padding="15,0">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock Text="Assignments" FontSize="14"/>
                </StackPanel>

            </Button>

            <!-- REPORTS -->
            <Button Background="Transparent"
            BorderThickness="0"
            Foreground="black"
            Height="40"
            HorizontalContentAlignment="Left"
            Padding="15,0">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📈" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock Text="Reports" FontSize="14"/>
                </StackPanel>

            </Button>

        </StackPanel>

        <!-- ⚪ MAIN CONTENT -->
        <Grid Grid.Row="1" Grid.Column="1">

            <Frame x:Name="MainFrame"
               NavigationUIVisibility="Hidden"/>

        </Grid>

    </Grid>

</Window>