<Page x:Class="InventoryManagementSystem.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Dashboard"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#333"
                   Margin="0,0,0,25"/>

        <!-- CARDS -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="3">

            <!-- Total Assets -->
            <Border Background="#4CAF50"
                    CornerRadius="15"
                    Margin="12"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Total Assets"
                               FontSize="16"
                               Foreground="White"
                               Opacity="0.9"/>

                    <TextBlock Text="{Binding TotalAssets}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>
            </Border>

            <!-- Assigned -->
            <Border Background="#2196F3"
                    CornerRadius="15"
                    Margin="12"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Assigned"
                               FontSize="16"
                               Foreground="White"
                               Opacity="0.9"/>

                    <TextBlock Text="{Binding AssignedAssets}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>
            </Border>

            <!-- Available -->
            <Border Background="#FF9800"
                    CornerRadius="15"
                    Margin="12"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Available Assets"
                               FontSize="16"
                               Foreground="White"
                               Opacity="0.9"/>

                    <TextBlock Text="{Binding AvailableAssets}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>
            </Border>

            <!-- Damaged -->
            <Border Background="#F44336"
                    CornerRadius="15"
                    Margin="12"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Damaged"
                               FontSize="16"
                               Foreground="White"
                               Opacity="0.9"/>

                    <TextBlock Text="{Binding DamagedAssets}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>
            </Border>

        </UniformGrid>

    </Grid>
</Page>