<Window x:Class="InventoryManagementSystem.Views.UserFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        Title="Add User" 
        Height="350" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Border Padding="20">
        <StackPanel>
            <!-- Title -->
            <TextBlock x:Name="FormTitle" 
                       Text="Add New User" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <!-- Name Field -->
            <TextBlock Text="Full Name" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="txtName" 
                     Height="30" 
                     Margin="0,0,0,15"
                     VerticalContentAlignment="Center"/>

            <!-- Department Field -->
            <TextBlock Text="Department" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <ComboBox x:Name="cmbDepartment" 
                      Height="30" 
                      Margin="0,0,0,15"
                      IsEditable="True"
                      Text="Select Department">
                <ComboBoxItem Content="IT"/>
                <ComboBoxItem Content="HR"/>
                <ComboBoxItem Content="Finance"/>
                <ComboBoxItem Content="Operations"/>
                <ComboBoxItem Content="Sales"/>
                <ComboBoxItem Content="Marketing"/>
            </ComboBox>

            <!-- Active Status -->
            <CheckBox x:Name="chkIsActive" 
                      Content="Active User" 
                      Margin="0,0,0,20" 
                      IsChecked="True"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="80"
                        Height="35"
                        Margin="0,0,10,0"
                        Background="#6c757d"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Cancel_Click"
                        IsCancel="True"/>

                <Button Content="Save"
                        Width="80"
                        Height="35"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Save_Click"
                        IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>