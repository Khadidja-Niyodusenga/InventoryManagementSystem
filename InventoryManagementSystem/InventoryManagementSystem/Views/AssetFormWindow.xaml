<Window x:Class="InventoryManagementSystem.Views.AssetFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InventoryManagementSystem.Views"
        mc:Ignorable="d"
        Title="AssetFormWindow" Height="500" Width="410">
    <StackPanel Margin="20">
        <TextBlock Text="Device Name" Margin="0,0,0,5"/>
        <TextBox x:Name="txtDeviceName" Margin="0,0,0,10"/>

        <TextBlock Text="Type" Margin="0,0,0,5"/>
        <TextBox x:Name="txtType" Margin="0,0,0,10"/>

        <TextBlock Text="Serial Number" Margin="0,0,0,5"/>
        <TextBox x:Name="txtSerial" Margin="0,0,0,10"/>

        <TextBlock Text="Specifications" Margin="0,0,0,5"/>
        <TextBox x:Name="txtSpecs" Margin="0,0,0,10"/>

        <TextBlock Text="Condition" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbCondition" Margin="0,0,0,10">
            <ComboBoxItem Content="Good"/>
            <ComboBoxItem Content="Needs Maintenance"/>
            <ComboBoxItem Content="Damaged"/>
        </ComboBox>
        <TextBlock Text="Status" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbStatus" Margin="0,0,0,10">
            <ComboBoxItem Content="Available"/>
            <ComboBoxItem Content="Assigned"/>
            <ComboBoxItem Content="Under Repair"/>
        </ComboBox>
        <TextBlock Text="Department" Margin="0,0,0,5"/>
        <TextBox x:Name="txtDepartment" Margin="0,0,0,20"/>

        <Button Content="Save"
                Background="#4CAF50"
                Foreground="White"
                Height="35"
                Click="Save_Click"/>
    </StackPanel>
</Window>
